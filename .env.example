# ============================================================
# Smart Knowledge Gap & Personalized Learning System
# Environment Variables Template
# ============================================================
#
# Copy this file to `.env` and fill in the real values.
# NEVER commit the actual `.env` file to version control.
#
# Example:
#   cp .env.example .env
# ============================================================

# Flask secret key for session signing.
# Generate a strong random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Flask environment: development | production
FLASK_ENV=development

# Flask debug mode: 1 to enable, 0 to disable
FLASK_DEBUG=1

# Host and port for local development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ============================================================
# AI / LLM
# ============================================================
# Groq API key (free tier available).
# Get one at: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key-here

# ============================================================
# Database (optional)
# ============================================================
# If set, the app uses PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
